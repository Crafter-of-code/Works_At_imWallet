# ============================================================
# Node.js / NestJS
# ============================================================

**/node_modules/
**/dist/
**/coverage/
**/.nyc_output/
**/.nestjs/
**/*.tsbuildinfo

# Environment / secrets
**/.env
**/.env.*
!.env.example

# Node debug logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# ============================================================
# Node.js / Project Keys & Secrets
# ============================================================

# Any folder named "keys" anywhere in any project
**/keys/

# Common key/certificate files anywhere
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore

# ============================================================
# Spring Boot / Java
# ============================================================

**/target/
**/*.class
**/build/
**/out/

# Maven
**/.mvn/timing.properties

# Gradle
**/.gradle/

# Java crash dumps
**/hs_err_pid*
**/replay_pid*

# ============================================================
# IDEs
# ============================================================

**/.idea/
**/*.iml

# Eclipse / Spring Tool Suite
**/.classpath
**/.project
**/.settings/
**/.factorypath

# ============================================================
# General
# ============================================================

**/*.log
**/*.pid
**/*.seed
**/*.pid.lock
**/keys/
**/key/

# macOS
**/.DS_Store
.DS_Store

# Ignore all Day folders' generated/dependency files
**/node_modules/
**/target/
**/build/
**/dist/
**/.gradle/
**/.idea/

# Secrets / keys
**/keys/
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks

# Environment files
**/.env
**/.env.*
!.env.example
